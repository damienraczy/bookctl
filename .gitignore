# Liste blanche : tout est ignoré, puis seuls les chemins de l'outil
# sont réautorisés explicitement (specs/PRINCIPES.md § 2, doc-tools/git.md).
# Ajouter un chemin ici est une décision volontaire.

/*

!/.gitignore
!/README.md
!/params.sample.yml
!/LICENSE.md
!/LICENSE-docs.md
!/NOTICE

!/specs/
/specs/*
!/specs/*.md

!/doc-tools/
/doc-tools/*
!/doc-tools/*.md

!/spikes/

# Exclus même dans les chemins autorisés : fichiers système, versions
# archivées (.arN) et dossiers old (specs/PRINCIPES.md § 2)
.DS_Store
*.ar[0-9]*.*
old/
out/
.venv/
__pycache__/
.pytest_cache/
